# ── data-master-ai backend config ───────────────────────────────────────────
APP_NAME=AgentWorks
DEBUG=true
PORT=8700
CORS_ORIGINS=*

# ── LLM provider ─────────────────────────────────────────────────────────────
# bedrock | openai   (openai = any OpenAI-compatible /v1 endpoint)
LLM_PROVIDER=bedrock
LLM_ENABLED=true

# ── Bedrock (Anthropic native Messages API + Cohere embed/rerank) ─────────────
BEDROCK_REGION=ap-southeast-1
# sigv4 = local SSO role (no bedrock:CallWithBearerToken); bearer = QA/prod
BEDROCK_ANTHROPIC_AUTH_MODE=sigv4
BEDROCK_CHAT_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_QUERY_REWRITER_MODEL=global.anthropic.claude-sonnet-5
BEDROCK_ANTHROPIC_MAX_TOKENS=16000

EMBEDDING_BEDROCK_ENABLED=true
BEDROCK_EMBEDDING_MODEL=global.cohere.embed-v4:0
BEDROCK_EMBEDDING_REGION=ap-southeast-1
BEDROCK_EMBEDDING_DIMENSION=1024

RERANKER_BEDROCK_ENABLED=true
BEDROCK_RERANKER_MODEL=cohere.rerank-v3-5:0
BEDROCK_RERANKER_REGION=ap-northeast-1

# AWS credentials come from the standard chain (env / AWS_PROFILE / ~/.aws / IRSA).
# Locally: AWS_PROFILE=lb-aiops-bedrock AWS_REGION=ap-southeast-1
# AWS_PROFILE=
# AWS_REGION=ap-southeast-1

# ── OpenAI-compatible provider (when LLM_PROVIDER=openai) ─────────────────────
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
# OpenAI-compatible embeddings/rerank (when the Bedrock ones are disabled)
EMBEDDING_API_ENABLED=false
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_API_MODEL=BAAI/bge-m3
RERANKER_API_ENABLED=false
RERANKER_API_URL=

# ── Vector store (milvus-lite file = zero infra; or a Milvus server URI) ──────
VECTOR_DB_URI=./data/milvus_lite.db
VECTOR_COLLECTION_PREFIX=aw_rag

# ── Memory / trace / platform-config persistence ─────────────────────────────
CHECKPOINTER=memory
CHECKPOINTER_SQLITE_PATH=./data/checkpoints.sqlite
DATABASE_URL=sqlite:///./data/platform.sqlite

# ── Identity ─────────────────────────────────────────────────────────────────
PLATFORM_JWT_SECRET=dev-only-change-me
PLATFORM_JWT_ALG=HS256
ALLOW_ANONYMOUS=true
